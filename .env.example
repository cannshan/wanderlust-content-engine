# Required — get one at https://console.anthropic.com (API keys tab).
# Cost: a few cents per generation on Claude Sonnet 5.
ANTHROPIC_API_KEY=

# Required to lock the site — pick any password. Leave blank to run
# unlocked while testing on your own machine.
DASHBOARD_PASSWORD=

# Optional — live trending-hashtag lookup via Apify (apify.com).
# Without these, the tool still works: Claude estimates tags from her
# proven patterns instead of live TikTok trend data.
#
# 1. Create a free Apify account (apify.com) — free tier includes monthly credits.
# 2. Pick an actor from https://apify.com/store?search=tiktok+hashtag
#    (e.g. "TikTok Hashtag Trends Scraper & Breakout Radar") and open its page.
# 3. Copy its actor id (shown as username~actor-name) into APIFY_ACTOR_ID.
# 4. Check that actor's "Input" tab for the field name it expects for a
#    search term/keyword, and set APIFY_INPUT_FIELD to match (defaults to
#    "searchTerms" if left blank).
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
APIFY_INPUT_FIELD=searchTerms
